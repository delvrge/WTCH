{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // The scripts/ helpers import the shared edge-function modules directly
    // (see scripts/preview-investigation.ts), which are written for Deno:
    // `.ts` extensions on relative imports and `npm:` specifiers. These two
    // settings let tsc follow them instead of erroring, so those modules are
    // typechecked here rather than only at deploy time.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "npm:@supabase/supabase-js@2": ["./node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "supabase"]
}
